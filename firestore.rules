rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/access/$(request.auth.uid)).data.allowed == true;
    }
    match /families/samnammae {
      allow read: if owner();
      allow create: if owner() && validState() && request.resource.data.revision == 1;
      allow update: if owner() && validState()
        && request.resource.data.revision == resource.data.revision + 1;
      function validState() {
        return request.resource.data.keys().hasOnly(['payload', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 800000
          && request.resource.data.revision is int
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
